+/// Row/col position within a buffer. `row` is 0-based line index, `col` is
+/// the char offset within that line.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Point {
+    pub row: u32,
+    pub col: u32,
+}
+
+impl Point {
+    pub fn new(row: u32, col: u32) -> Self {
+        Self { row, col }
+    }
+}
