+use std::ops::Range;
+
+/// Literal search over a haystack, returning byte-offset ranges of every
+/// match, capped at `limit`. Case-insensitive folds via `to_lowercase`.
+pub fn search(haystack: &str, needle: &str, case_sensitive: bool, limit: usize) -> Vec<Range<usize>> {
+    if needle.is_empty() || limit == 0 {
+        return Vec::new();
+    }
+
+    if case_sensitive {
+        haystack
+            .match_indices(needle)
+            .take(limit)
+            .map(|(start, matched)| start..start + matched.len())
+            .collect()
+    } else {
+        let haystack_lower = haystack.to_lowercase();
+        let needle_lower = needle.to_lowercase();
+        haystack_lower
+            .match_indices(&needle_lower)
+            .take(limit)
+            .map(|(start, matched)| start..start + matched.len())
+            .collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn finds_all_case_sensitive_matches() {
+        let hits = search("foo Foo foo", "foo", true, 10);
+        assert_eq!(hits.len(), 2);
+    }
+
+    #[test]
+    fn finds_all_case_insensitive_matches() {
+        let hits = search("foo Foo foo", "foo", false, 10);
+        assert_eq!(hits.len(), 3);
+    }
+}
