-use mylib::Buffer;
+use mylib::{Buffer, Point};

 #[test]
 fn insert_bumps_version() {
-    let mut buffer = Buffer::new("hello");
-    buffer.insert(5, " world");
-    assert_eq!(buffer.text(), "hello world");
+    let mut buffer = Buffer::from_text("hello");
+    let version = buffer.insert(5, " world");
+    assert_eq!(buffer.text(), "hello world");
+    assert_eq!(version, 1);
+    assert!(buffer.is_dirty());
 }

 #[test]
 fn delete_removes_range() {
-    let mut buffer = Buffer::new("hello world");
+    let mut buffer = Buffer::from_text("hello world");
     buffer.delete(5..11);
     assert_eq!(buffer.text(), "hello");
 }
+
+#[test]
+fn offset_to_point_resolves_row_and_col() {
+    let buffer = Buffer::from_text("abc\ndef\nghi");
+    assert_eq!(buffer.offset_to_point(0), Point::new(0, 0));
+    assert_eq!(buffer.offset_to_point(4), Point::new(1, 0));
+    assert_eq!(buffer.offset_to_point(6), Point::new(1, 2));
+}
+
+#[test]
+fn mark_clean_resets_dirty_flag() {
+    let mut buffer = Buffer::from_text("abc");
+    buffer.insert(3, "d");
+    assert!(buffer.is_dirty());
+    buffer.mark_clean();
+    assert!(!buffer.is_dirty());
+}
